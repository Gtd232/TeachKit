                <group id="highlightGroup" label="高亮助手">
                    <button id="btnToggleHighlight" getLabel="ribbon.OnGetLabel" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <dropDown id="drpHighlightColor" label="颜色选择" onAction="ribbon.OnAction" getSelectedItemID="ribbon.OnGetSelectedItemID">
                        <item id="highlightNone" label="无高亮" />
                        <item id="colorYellow" label="黄色" />
                        <item id="colorGreen" label="绿色" />
                        <item id="colorCyan" label="青色" />
                        <item id="colorPink" label="粉色" />
                    </dropDown>

                    <button id="btnToggleFontColor" getLabel="ribbon.OnGetLabel" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <dropDown id="drpFontColor" label="字色选择" onAction="ribbon.OnAction" getSelectedItemID="ribbon.OnGetSelectedItemID">
                        <item id="fontBlack" label="黑色" />
                        <item id="fontRed" label="红色" />
                        <item id="fontBlue" label="蓝色" />
                        <item id="fontGreen" label="绿色" />
                        <item id="fontWhite" label="白色" />
                    </dropDown>
                </group>
                <group id="animationGroup" label="动画助手">
                    <button id="btnSplitTextAnimation" getLabel="ribbon.OnGetLabel" onAction="ribbon.OnAction" getImage="ribbon.GetImage" size="large"/>
                    <checkBox id="chkSplitUnderlineOriginal" label="原文字下划线" onAction="ribbon.OnAction" getPressed="ribbon.OnGetPressed"/>
                    <checkBox id="chkSplitNewTextRed" label="新文字红色" onAction="ribbon.OnAction" getPressed="ribbon.OnGetPressed"/>
                </group>
            </tab>
        </tabs>
    </ribbon>
